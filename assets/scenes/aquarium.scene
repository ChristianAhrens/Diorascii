# Underwater scene: sky | water | sandy seabed.
name: aquarium
title: Aquarium
order: 10

sky: #4a9fe0 #bfe4f6
medium-colors: #2aa6cf #0b3f78
ground-colors: #967c52 #765e3c
surface-color: #afe8f5
surface-glyphs: ~-_
ground-glyphs: .,'`. : 
sky-fraction: 0.2
sky-rows: 1..5
ground-rows: 2
stars: 23
day-night: yes
day-length: 240
start-hour: 11
sun-sprite: sun_big
moon-sprite: moon_big
action: drop food
overcast-tint: #24103e 0.6
action-label: Feed the fish
event-first: 8..16
event-interval: 40..90

--- population
# sprite     mode        amount
darter       per-cells   520
guppy        per-cells   650
tang         per-cells   750
angel        per-cells   1500
puffer       per-cells   1900
eel          per-cells   2600
grouper      per-cells   3200
jelly        per-cells   1500
crab         per-cols    90
@seaweed     per-cols    20

--- decor
# sprite     align       margin
castle       right       2
coral        left        5
coral        random      0

--- events
# sprite     weight
shark        3
ship         2
whale        2

--- rare
kraken         1
