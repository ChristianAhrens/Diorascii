# Script mode: cmake -DOUT=<file.cpp> -DROOT=<dir> -DFILES=<a|b|c> -P embed.cmake
# Generates a C++ source holding every asset (relative to ROOT) as a byte array,
# so the binary is self-contained.
string(REPLACE "|" ";" file_list "${FILES}")

set(body "// Generated by cmake/embed.cmake - do not edit.\n#include \"core/assets.h\"\n\nnamespace dio {\nnamespace {\n")
set(table "")
set(index 0)
foreach(f IN LISTS file_list)
  file(RELATIVE_PATH rel "${ROOT}" "${f}")
  file(READ "${f}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "const unsigned char d${index}[] = {${bytes}0x00};\n")
  string(APPEND table "    {\"${rel}\", d${index}, sizeof(d${index}) - 1},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "}  // namespace\n\nconst EmbeddedAsset kEmbeddedAssets[] = {\n${table}};\nconst size_t kEmbeddedAssetCount = ${index};\n\n}  // namespace tm\n")
file(WRITE "${OUT}" "${body}")
