# Forest: trees on a grassy bank, a small river in the foreground, rain on demand.
name: forest
title: Forest
order: 15

medium: no
sky-fraction: 1
sky: #4a90d0 #b4dcf0
ground-colors: #4a9a3e #356f2d
ground-glyphs: ,   "    '       .        ,     
ground-rows: 8
river-rows: 3
river-colors: #4aa0d8 #1f6aa5
river-flow: 2.5
action: weather raindrop
action-label: Make it rain
weather-duration: 18
stars: 20
day-night: yes
day-length: 240
start-hour: 10
sun-sprite: sun_big
moon-sprite: moon_big
event-first: 6..14
event-interval: 25..60

--- population
# sprite       mode       amount
pine_big       per-cols   9
pine_small     per-cols   7
oak            per-cols   14
bush           per-cols   8
flower         per-cols   6
cloud_big      per-cols   45
cloud_small    per-cols   30
bird           per-cols   40
deer           per-cols   38
rabbit         per-cols   50
duck           per-cols   45
butterfly      per-cols   18
firefly        per-cols   5

--- decor
# sprite       align      margin
reeds          random     0     y -5
reeds          random     0     y -5
reeds          random     0     y -5

--- events
eagle          1
